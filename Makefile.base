# Base Makefile that actually builds the PSP app inside the build/ directory.
# This file is invoked from the top-level Makefile using:
#   $(MAKE) -C build -f ../Makefile.base

ROOT ?= ..

TARGET = PSPWebFile

# Look for sources in project root; objects are emitted in current dir (build/)
VPATH := $(ROOT)

OBJS = main.o

INCDIR = 
CFLAGS = -O2 -G0 -Wall
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)

LIBDIR =
LDFLAGS =
LIBS = -lpsppower -lpspnet -lpspnet_inet -lpspnet_apctl -lpspnet_resolver -lpsputility

EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = PSP Web File Browser
# Use menu assets from the project root (use NULL if files don't exist)
PSP_EBOOT_ICON = $(if $(wildcard $(ROOT)/assets/ICON0.PNG),$(ROOT)/assets/ICON0.PNG,NULL)
PSP_EBOOT_PIC1 = $(if $(wildcard $(ROOT)/assets/PIC1.PNG),$(ROOT)/assets/PIC1.PNG,NULL)

PSPSDK=$(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
